# ZUI Library Internal Resources
# These are embedded into libzui and available via res:/zui/...

# Shaders
zui/shaders/rect.vert = ../assets/shaders/rect.vert
zui/shaders/rect.frag = ../assets/shaders/rect.frag
zui/shaders/texture.vert = ../assets/shaders/texture.vert
zui/shaders/texture.frag = ../assets/shaders/texture.frag
zui/shaders/glyph.vert = ../assets/shaders/glyph.vert
zui/shaders/glyph.frag = ../assets/shaders/glyph.frag
zui/shaders/circle.vert = ../assets/shaders/circle.vert
zui/shaders/circle.frag = ../assets/shaders/circle.frag
zui/shaders/arc.vert = ../assets/shaders/arc.vert
zui/shaders/arc.frag = ../assets/shaders/arc.frag
zui/shaders/poly.vert = ../assets/shaders/poly.vert
zui/shaders/poly.frag = ../assets/shaders/poly.frag
zui/shaders/blur.vert = ../assets/shaders/blur.vert
zui/shaders/blur.frag = ../assets/shaders/blur.frag
zui/shaders/frosted.vert = ../assets/shaders/frosted.vert
zui/shaders/frosted.frag = ../assets/shaders/frosted.frag

# Window decoration icons
zui/icons/close.svg = ../assets/icons/x-exit-icon.svg
zui/icons/minimize.svg = ../assets/icons/x-minimize-icon.svg
zui/icons/maximize.svg = ../assets/icons/x-maximize-icon.svg
zui/icons/restore.svg = ../assets/icons/x-restore-icon.svg
zui/icons/hidden.svg = ../assets/icons/x-hidden-icon.svg

# UI icons
zui/icons/check.svg = ../assets/icons/x-check-icon.svg
zui/icons/chevron-up.svg = ../assets/icons/x-chevron-up.svg
zui/icons/chevron-down.svg = ../assets/icons/x-chevron-down.svg

# Logo
zui/logo/white.png = ../assets/logo/zui-logo-white.png
